{
  "id": "/",
  "name": "herdr deck",
  "short_name": "herdr deck",
  "description": "Every agent session running in herdr on your Mac: status, story, live terminal.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#151d26",
  "theme_color": "#151d26",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "New session", "url": "/?new=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Needs input", "url": "/?status=blocked", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
